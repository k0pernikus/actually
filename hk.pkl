amends "package://github.com/jdx/hk/releases/download/v1.50.0/hk@1.50.0#/Config.pkl"

env {
  ["VIRTUAL_ENV"] = ".venv"
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    stage = true
    steps {
      ["python-format"] {
        glob = "**/*.py"
        fix = "uv run ruff format {{files}}"
      }
      ["python-lint"] {
        glob = "**/*.py"
        depends = List("python-format")
        check = "uv run ruff check {{files}}"
      }
      ["python-typecheck"] {
        glob = "**/*.py"
        depends = List("python-lint")
        check = "uv run ty check src tests scripts"
      }
      ["actually-self-check"] {
        glob = "**/*.py"
        depends = List("python-format")
        check = "uv run actually check {{files}}"
      }
      ["toml-format"] {
        glob = "**/*.toml"
        fix = "uv run taplo format {{files}}"
      }
      ["ruff-config-whole-tree"] {
        glob = "ruff.toml"
        depends = List("toml-format")
        fix = "uv run ruff format . && uv run ruff check --fix ."
      }
      ["ty-config-whole-tree"] {
        glob = "ty.toml"
        depends = List("toml-format")
        check = "uv run ty check src tests scripts"
      }
      ["regenerate-docs"] {
        depends = List("toml-format")
        glob =
          List(
            "README.md",
            "README.template.md",
            "src/actually/rules.toml",
            "src/actually/metadata.py",
            "rules/**/*.md",
            "scripts/generate_docs.py",
          )
        fix = "uv run python scripts/generate_docs.py"
        stage = List("README.md", "rules")
      }
    }
  }
  ["post-checkout"] {
    steps {
      ["pin-generated-readonly"] {
        check = "uv run --no-project python scripts/pin_generated_readonly.py"
      }
    }
  }
  ["post-merge"] {
    steps {
      ["pin-generated-readonly"] {
        check = "uv run --no-project python scripts/pin_generated_readonly.py"
      }
    }
  }
  ["post-rewrite"] {
    steps {
      ["pin-generated-readonly"] {
        check = "uv run --no-project python scripts/pin_generated_readonly.py"
      }
    }
  }
  ["pre-push"] {
    steps {
      ["docs-in-sync"] {
        check = "uv run python scripts/generate_docs.py --check"
      }
      ["uv-lock-in-sync"] {
        check = "uv lock --check"
      }
    }
  }
}
